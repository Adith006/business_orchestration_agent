
# Application
APP_NAME=Business Orchestrator
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1

# PostgreSQL
POSTGRES_USER=business_admin
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=business_orchestrator
DATABASE_URL=postgresql+asyncpg://business_admin:change_this_password@localhost:5432/business_orchestrator

# Redis
REDIS_URL=redis://localhost:6379/0
# Authentication
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
